pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to build and deploy')
  }

  environment {
    DOCKERHUB_NAMESPACE = credentials('dockerhub-username')
    BACKEND_IMAGE = "${DOCKERHUB_NAMESPACE}/repo2docker-backend:${params.IMAGE_TAG}"
    FRONTEND_IMAGE = "${DOCKERHUB_NAMESPACE}/repo2docker-frontend:${params.IMAGE_TAG}"
    RELEASE_NAME = "repo2docker"
    RELEASE_NAMESPACE = "repo2docker"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Backend Unit Tests') {
      steps {
        dir('backend') {
          sh '''
            set -eu
            python3 -m venv .venv
            . .venv/bin/activate
            pip install -r requirements.txt
            python -m compileall app
          '''
        }
      }
    }

    stage('Frontend Build Gate') {
      steps {
        dir('frontend') {
          sh '''
            set -eu
            npm ci
            npm run build
          '''
        }
      }
    }

    stage('Docker Build') {
      steps {
        sh '''
          set -eu
          docker build -t "$BACKEND_IMAGE" backend
          docker build -t "$FRONTEND_IMAGE" frontend
        '''
      }
    }

    stage('Security Scan') {
      steps {
        sh '''
          set -eu
          if command -v trivy >/dev/null 2>&1; then
            trivy image --severity CRITICAL --exit-code 1 "$BACKEND_IMAGE"
            trivy image --severity CRITICAL --exit-code 1 "$FRONTEND_IMAGE"
          else
            echo "Trivy is not installed; skipping image scan."
          fi
        '''
      }
    }

    stage('Docker Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_PASSWORD')]) {
          sh '''
            set -eu
            echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
            docker push "$BACKEND_IMAGE"
            docker push "$FRONTEND_IMAGE"
          '''
        }
      }
    }

    stage('Deploy to K3s') {
      steps {
        withCredentials([
          string(credentialsId: 'jenkins-api-token', variable: 'APP_JENKINS_API_TOKEN'),
          string(credentialsId: 'gemini-api-key', variable: 'APP_GEMINI_API_KEY'),
          string(credentialsId: 'jenkins-username', variable: 'APP_JENKINS_USERNAME')
        ]) {
          sh '''
            set -eu
            helm upgrade --install "$RELEASE_NAME" charts/repo2docker \
              --namespace "$RELEASE_NAMESPACE" \
              --create-namespace \
              --set images.backend.repository="$DOCKERHUB_NAMESPACE/repo2docker-backend" \
              --set images.frontend.repository="$DOCKERHUB_NAMESPACE/repo2docker-frontend" \
              --set images.backend.tag="${IMAGE_TAG}" \
              --set images.frontend.tag="${IMAGE_TAG}" \
              --set backend.env.dockerhubUsername="$DOCKERHUB_NAMESPACE" \
              --set backend.secrets.jenkinsUsername="$APP_JENKINS_USERNAME" \
              --set backend.secrets.jenkinsApiToken="$APP_JENKINS_API_TOKEN" \
              --set backend.secrets.geminiApiKey="$APP_GEMINI_API_KEY"
            kubectl rollout status deployment/repo2docker-backend -n "$RELEASE_NAMESPACE" --timeout=180s
            kubectl rollout status deployment/repo2docker-frontend -n "$RELEASE_NAMESPACE" --timeout=180s
          '''
        }
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          set -eu
          kubectl -n "$RELEASE_NAMESPACE" run repo2docker-smoke --rm -i --restart=Never --image=curlimages/curl:8.10.1 -- \
            curl -fsS http://repo2docker-backend:8000/health
        '''
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
    }
  }
}
