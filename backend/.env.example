DATABASE_URL=sqlite:///./repo2docker.db
CORS_ORIGINS=http://localhost:5173

JENKINS_URL=http://localhost:8080
JENKINS_JOB_NAME=repo2docker
JENKINS_USERNAME=your-jenkins-user
JENKINS_API_TOKEN=your-jenkins-api-token
JENKINS_POLL_INTERVAL_SECONDS=5

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

DOCKERHUB_USERNAME=your-dockerhub-username

PREVIEW_DEPLOY_ENABLED=false
PREVIEW_BASE_URL=http://localhost
PREVIEW_NAMESPACE_PREFIX=repo2docker-preview
PREVIEW_MIN_REPLICAS=1
PREVIEW_MAX_REPLICAS=3
PREVIEW_CPU_TARGET_PERCENTAGE=70

OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=repo2docker-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
